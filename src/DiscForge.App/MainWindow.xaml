<Window x:Class="DiscForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="980"
        Height="660"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#10141B"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1A2030" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
            <Grid>
                <StackPanel x:Name="ArtworkPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#243049" HorizontalAlignment="Center"/>
                    <TextBlock Text="Illustration" Foreground="#9AA6B8" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <Image x:Name="ArtworkImage"
                       Source="{Binding ArtworkPath, Converter={StaticResource Artwork}}"
                       Stretch="Uniform"
                       Margin="18"
                       ImageFailed="ArtworkFailed"/>
            </Grid>
        </Border>

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource OptionalText}" FontSize="16" Foreground="#E4B15A" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Edition}" Style="{StaticResource OptionalText}" FontSize="15" Foreground="#C5CEDC" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding FilesystemLine}" Style="{StaticResource OptionalText}" FontSize="13" Foreground="#9AA6B8" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding StatsLine}" Style="{StaticResource OptionalText}" FontSize="18" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding FolderHint}" Style="{StaticResource OptionalText}" Foreground="#9AA6B8" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <Button Content="Copier sur mon PC"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CopyCommand}"
                        Visibility="{Binding ShowReady, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Instructions"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleInstructionsCommand}"
                        Visibility="{Binding ShowInstructionButton, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Remplacer les fichiers du disque"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ReplaceCommand}"
                        Visibility="{Binding ShowConflict, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Conserver les fichiers existants"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding KeepCommand}"
                        Visibility="{Binding ShowConflict, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Choisir un autre dossier"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ElsewhereCommand}"
                        Visibility="{Binding ShowConflict, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Annuler"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding ShowWorking, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Ouvrir le dossier"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenFolderCommand}"
                        Visibility="{Binding ShowDone, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding BlockingError}"
                               FontSize="16"
                               Foreground="#F0B4B4"
                               Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Visibility="{Binding ShowConflict, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Ce dossier existe déjà" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ConflictPath}" Foreground="#E4B15A" Margin="0,8,0,0"/>
                        <TextBlock Text="Les fichiers qui ne viennent pas du disque ne seront pas supprimés. Remplacer n'écrase que les fichiers présents sur le disque. Conserver laisse intacts ceux qui sont déjà là."
                                   Foreground="#C5CEDC"
                                   Margin="0,12,0,0"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowWorking, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PhaseTitle}" FontSize="20" FontWeight="SemiBold"/>
                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding ProgressDetail}" Foreground="#C5CEDC" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding CurrentFile}" Foreground="#9AA6B8" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowDone, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ResultTitle}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ResultDetail}" Foreground="#C5CEDC" Margin="0,8,0,0"/>
                        <TextBlock Text="Dossier" Foreground="#9AA6B8" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding DestinationPath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#F3F5F8"
                                 TextWrapping="Wrap"
                                 IsReadOnlyCaretVisible="True"/>
                    </StackPanel>

                    <TextBlock Text="{Binding NoticeText}"
                               Foreground="#E7C27A"
                               Margin="0,16,0,0"
                               Visibility="{Binding ShowNotices, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding IssueText}"
                               Foreground="#E7C27A"
                               Margin="0,16,0,0"
                               Visibility="{Binding ShowIssues, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowInstructions, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Instructions" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Instructions}" Foreground="#C5CEDC" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
